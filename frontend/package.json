{
  "name": "learnflow-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "contract:export": "../backend/.venv/bin/python ../backend/scripts/export_openapi.py",
    "contract:types": "npm run contract:export && openapi-typescript ../docs/openapi.json -o src/api/types.ts",
    "contract:check": "cd ../backend && .venv/bin/python -m pytest tests/test_contract.py"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "openapi-fetch": "^0.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
